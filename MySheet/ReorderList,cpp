#include<bits/stdc++.h>
using namespace std;
struct node {
    int data;
    node*next;
    node(int val){
    data = val;
    next = nullptr;
    }
};
class Solution {
public:
    void reorderList(node* head) {

        if (head == nullptr || head->next == nullptr)
            return;

        //  Find middle
        node* slow = head;
        node* fast = head;

        while (fast != nullptr && fast->next != nullptr) {
            slow = slow->next;
            fast = fast->next->next;
        }

        //  Reverse second half
        node* prev = nullptr;
        node* curr = slow;

        while (curr != nullptr) {
            node* next = curr->next;
            curr->next = prev;
            prev = curr;
            curr = next;
        }

  //merge
        node* first = head;
        node* second = prev;

        while (second->next != nullptr) {
            node* temp1 = first->next;
            node* temp2 = second->next;

            first->next = second;
            second->next = temp1;

            first = temp1;
            second = temp2;
        }
    }
};